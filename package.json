{
  "name": "highlight-translator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "build:dev": "wxt build --mode development",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "pnpm build && playwright test --project=chromium-extension",
    "test:e2e:headed": "pnpm build && playwright test --project=chromium-extension --headed",
    "test:e2e:debug": "pnpm build && playwright test --project=chromium-extension --debug",
    "test:server": "node tests/support/test-server.mjs",
    "test:install": "playwright install --no-shell chromium",
    "check": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm zip"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.1.31",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "@wxt-dev/module-react": "^1.1.4",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^27.0.1",
    "postcss-rem-to-responsive-pixel": "^6.0.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3",
    "wxt": "^0.21.4"
  }
}
